;; open-cofog (etzhayyim-open-cofog) worker status page — single-page app,
;; single build/module.
{:deps   {:aliases [:cljs :test]}
 :builds {:app  {:target :browser
                 :output-dir "public/js"
                 :asset-path "js"
                 :modules {:app {:init-fn open-cofog.app/main}}}
          :test {:target :node-test
                 :output-to "out/tests.js"
                 :ns-regexp "-test$"}}}
